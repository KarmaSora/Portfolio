Main:
    METHOD Main IN Main
    __t0 := NEW Fac
     @param: 10
    __t1 := CALL ComputeFac: 1
    PRINT __t1
    EXIT

Fac_ComputeFac:
    METHOD Fac IN ComputeFac
    Unknown TAC: PARAM
    __t2 := num < 1
    if __t2 goto block_1 else goto block_2

block_1:
    num_aux := 1
    goto block_3

block_2:
    __t5 := num - 1
     @param: __t5
    __t4 := CALL ComputeFac: 1
    __t3 := num * __t4
    num_aux := __t3
    goto block_3

block_3:
    RETURN num_aux

