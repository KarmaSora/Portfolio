Main:
    METHOD Main IN Main
    __t0 := NEW Sum
     @param: 100
    __t1 := CALL calcSum: 1
    PRINT __t1
    EXIT

Sum_calcSum:
    METHOD Sum IN calcSum
    Unknown TAC: PARAM
    sum := 0
    goto whileCondition_1

whileCondition_1:
    __t2 := 0 < num
    if __t2 goto whileBody_2 else goto whileExit_3

whileBody_2:
    __t3 := sum < 100
    if __t3 goto block_4 else goto block_5

whileExit_3:
    RETURN sum

block_4:
    __t4 := sum + num
    sum := __t4
    goto block_6

block_5:
    goto block_6

block_6:
    __t5 := num - 1
    num := __t5
    goto whileCondition_1

